# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

### Python ###
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class


# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# MagicReader runtime data #
############################
# These are rewritten by the web UI on every edit. Tracking them meant any
# commit touching data/ collided with local changes on every deployed Pi.
# The repo ships *.default.json templates; the app copies them into place on
# first run (see magicreader/jsonStore.py).
/data/*.json
!/data/*.default.json
/data/*.bak
/data/.tmp-*
