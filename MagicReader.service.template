# Rendered by service-install.sh, which substitutes:
#   @SERVICE_USER@  the user running the installer
#   @SERVICE_UID@   that user's numeric uid
#   @REPO_DIR@      the absolute path of this repository
# Do not install this file directly - the placeholders are not valid systemd.
[Unit]
Description=MagicReader
Wants=network-online.target
Wants=systemd-udev-settle.service
After=network-online.target systemd-udev-settle.service sound.target

[Service]
Type=simple
User=@SERVICE_USER@
SupplementaryGroups=spi gpio audio
# Allow the service user to bind the web server to port 80.
AmbientCapabilities=CAP_NET_BIND_SERVICE
WorkingDirectory=@REPO_DIR@
Environment="XDG_RUNTIME_DIR=/run/user/@SERVICE_UID@"
Environment=PYTHONUNBUFFERED=1
# SDL tries pulseaudio before alsa and takes whichever connects first.
# On a Lite image nothing answers on the PulseAudio socket so it lands on
# alsa. If a sound server is present (PipeWire ships a PulseAudio socket)
# and audio goes wrong - silence, or output on HDMI instead of the jack -
# uncomment this to pin SDL to alsa. The app logs the driver it chose at
# startup; check that line first.
#Environment=SDL_AUDIODRIVER=alsa
ExecStart=@REPO_DIR@/.venv/bin/python @REPO_DIR@/magicreader/__main__.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
